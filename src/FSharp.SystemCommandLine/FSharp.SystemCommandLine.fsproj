<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net6.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
	<!-- Local builds only: the published version comes from the git tag (see .github/workflows/publish.yml). -->
	<Version>2.3.0</Version>
	<Description>F# computation expressions for working with the System.CommandLine API.</Description>
	<Authors>Jordan Marr</Authors>
	<PackageTags>F# fsharp System.CommandLine cli</PackageTags>
	<PackageProjectUrl>https://github.com/JordanMarr/FSharp.SystemCommandLine</PackageProjectUrl>
	<PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Aliases.fs" />
    <Compile Include="Inputs.fs" />
    <Compile Include="InputBuilder.fs" />
    <Compile Include="CommandBuilders.fs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="FSharp.SystemCommandLine.TrimmerRoots.xml"
                      LogicalName="ILLink.Descriptors.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="6.0.0" />
  </ItemGroup>

</Project>
