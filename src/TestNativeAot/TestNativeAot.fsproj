<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <IsPackable>false</IsPackable>
    <RestoreAdditionalProjectSources>$(MSBuildThisFileDirectory)obj/packages</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
    <!-- Consume the package, including its embedded descriptor, without application roots. -->
    <PackageReference Include="FSharp.SystemCommandLine" Version="$(SmokePackageVersion)" />
  </ItemGroup>
</Project>
